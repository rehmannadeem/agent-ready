{
  "name": "armans-agent-ready-live",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "npx wrangler@4.158.0 dev",
    "deploy": "npx wrangler@4.158.0 deploy",
    "check": "node --check src/worker.mjs && node --check public/app.js",
    "dev:local": "wrangler dev --config wrangler.local.jsonc",
    "test:local": "node test/local-runtime.mjs",
    "catalogue:generate": "node catalogue/generate.mjs",
    "catalogue:preflight": "node catalogue/seed.mjs",
    "eval:plan": "node evals/run.mjs --plan"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "graphql": "17.1.0",
    "wrangler": "4.158.0"
  }
}

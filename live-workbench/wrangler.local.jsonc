{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "armans-agent-ready-gate6-local",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/ucp", "/agent-profile.json"]
  },
  "durable_objects": {"bindings": [{"name":"SESSION_STATE","class_name":"ArmansSessionState"}]},
  "migrations": [{"tag":"gate6-v1","new_sqlite_classes":["ArmansSessionState"]}],
  "vars": {
    "SHOPIFY_STORE": "karachi-kicks-supportops-lab.myshopify.com",
    "SHOPIFY_API_VERSION": "2026-07",
    "UCP_AGENT_PROFILE_URL": "https://armans-agent-ready-live.veenus-rehman.workers.dev/agent-profile.json",
    "OBSERVABILITY_ENABLED": "true"
  },
  "observability": {"enabled": true},
  "dev": {"ip":"127.0.0.1", "port":8787, "local_protocol":"http"}
}
